@using SimpleCRUD.UI.ViewModels
@model IEnumerable<ApplicationUserViewModel>

@{
    ViewBag.Title = "Application Users";
}

<h2>Application Users</h2>
<p>
    <a href="@Url.Action("Create")">Create New Application User</a>
</p>
<table class="table">
    <tr>
        <th>Id</th>
        <th>User Name</th>
        <th>Application Id</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.UserName</td>
            <td>@item.ApplicationId</td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.Id })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
            </td>
        </tr>
    }
</table>