@using SimpleCRUD.UI.ViewModels
@model IEnumerable<ApplicationRoleViewModel>

@{
    ViewBag.Title = "Application Roles";
}

<h2>Application Roles</h2>
<p>
    <a href="@Url.Action("Create")">Create New Application Role</a>
</p>
<table class="table">
    <tr>
        <th>Id</th>
        <th>Role Name</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ApplicationRoleId</td>
            <td>@item.</td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.Id })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
            </td>
        </tr>
    }
</table>