@using SimpleCRUD.UI.ViewModels
@model IEnumerable<ApplicationUserRoleViewModel>

@{
    ViewBag.Title = "Application User Roles";
}

<h2>Application User Roles</h2>
<p>
    <a href="@Url.Action("Create")">Create New Application User Role</a>
</p>
<table class="table">
    <tr>
        <th>Id</th>
        <th>Application User Id</th>
        <th>Application Role Id</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.ApplicationUserId</td>
            <td>@item.ApplicationRoleId</td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.Id })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
            </td>
        </tr>
    }
</table>