@using SimpleCRUD.UI.ViewModels
@model IEnumerable<ApplicationViewModel>

@{
    ViewBag.Title = "Applications";
}

<h2>Applications</h2>
<p>
    <a href="@Url.Action("Create")">Create New Application</a>
</p>
<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ApplicationId</td>
            <td>@item.ApplicationName</td>
            <td>
                <a href="@Url.Action("Edit", new { id = item.ApplicationId })">Edit</a> |
                <a href="@Url.Action("Delete", new { id = item.ApplicationId })">Delete</a>
            </td>
        </tr>
    }
</table>